[Unit]
Description=Verify YooKassa payments and reconcile reservations
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=dari
Group=www-data
SupplementaryGroups=dari
WorkingDirectory=/srv/dari/current
EnvironmentFile=/etc/dari/dari.env
ExecStart=/usr/bin/flock -n /srv/dari/shared/reconcile.lock /srv/dari/current/.venv/bin/python manage.py reconcile_payments
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dari/shared
