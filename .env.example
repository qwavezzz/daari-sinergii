# Production: load with systemd EnvironmentFile outside /srv/dari/current.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://dari:CHANGE_ME@127.0.0.1:5432/dari
MAIN_HOST=dari-sinergii.ru
SHOP_HOST=shop.dari-sinergii.ru
MAIN_ORIGIN=https://dari-sinergii.ru
SHOP_ORIGIN=https://shop.dari-sinergii.ru
SITE_INDEXING_ENABLED=true
# Keep false until real catalog and public store content are approved.
SHOP_INDEXING_ENABLED=false
STATIC_ROOT=/srv/dari/shared/static
MEDIA_ROOT=/srv/dari/shared/media
PRIVATE_MEDIA_ROOT=/srv/dari/shared/private-media
CONTENT_VIDEO_PROVIDERS=
CONTENT_DOCUMENT_MAX_BYTES=31457280
CONTENT_IMAGE_MAX_BYTES=8388608
HSTS_SECONDS=0
# Begin with 300 seconds only after HTTPS and renewal checks; do not preload.
HSTS_INCLUDE_SUBDOMAINS=false
CART_SESSION_DAYS=30
RESERVATION_MINUTES=30
# Enable only after assortment, delivery and terms are approved.
CHECKOUT_ENABLED=false
# Rehearsal payment page. Defaults to true ONLY in config.settings_dev.
# Trial orders remain permanently separated from Alfa-Bank charges.
PAYMENT_STUB_ENABLED=false
ALFABANK_ENABLED=false
ALFABANK_USERNAME=
ALFABANK_PASSWORD=
ALFABANK_TEST_MODE=true
ALFABANK_LIVE_APPROVED=false
# unconfigured | bank (approved bank fiscalization) | external (approved external cash register)
ALFABANK_RECEIPT_MODE=unconfigured
# Tax system must be agreed with the seller/accountant before bank fiscalization.
ALFABANK_TAX_SYSTEM=
# First carrier: CDEK. Waybills are created manually after confirmed payment.
CDEK_ENABLED=false
CDEK_TEST_MODE=true
# Local dev only: use CDEK's published shared sandbox account when own keys are empty.
# Does not apply to production settings or CDEK_TEST_MODE=false.
CDEK_PUBLIC_SANDBOX=true
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Sender: Tolyatti. Fill the numeric city code from the CDEK directory.
# Sender handover mode determines the tariff configured in Admin.
CDEK_FROM_CITY_CODE=
# OpenStreetMap needs no map API key. Only visible tiles are loaded; retain attribution.
CDEK_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Additional plain-text attribution if using another tile provider (OSM credit stays visible).
CDEK_MAP_ATTRIBUTION=
CDEK_QUOTE_TTL_SECONDS=900
CDEK_TIMEOUT_SECONDS=10
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional fallback; recipient and Reply-To can be changed in Admin / Orders / Email notifications.
EMAIL_REPLY_TO=
MANAGER_EMAIL=
# Configure private libpq service/password files for backup; do not put DB passwords in argv.
PGSERVICE=dari-backup
PGSERVICEFILE=/etc/dari/pg_service.conf
PGPASSFILE=/etc/dari/pgpass
