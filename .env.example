# Production: load with systemd EnvironmentFile outside /srv/dari/current.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://dari:CHANGE_ME@127.0.0.1:5432/dari
MAIN_HOST=dari-sinergii.ru
SHOP_HOST=shop.dari-sinergii.ru
MAIN_ORIGIN=https://dari-sinergii.ru
SHOP_ORIGIN=https://shop.dari-sinergii.ru
STATIC_ROOT=/srv/dari/shared/static
MEDIA_ROOT=/srv/dari/shared/media
PRIVATE_MEDIA_ROOT=/srv/dari/shared/private-media
CONTENT_VIDEO_PROVIDERS=
CONTENT_DOCUMENT_MAX_BYTES=31457280
CONTENT_IMAGE_MAX_BYTES=8388608
HSTS_SECONDS=0
CART_SESSION_DAYS=30
RESERVATION_MINUTES=30
# Enable only after assortment, delivery and terms are approved.
CHECKOUT_ENABLED=false
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
YOOKASSA_LIVE_APPROVED=false
# unconfigured | provider (items fiscalized by YooKassa) | external (approved external register)
YOOKASSA_RECEIPT_MODE=unconfigured
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional fallback; recipient and Reply-To can be changed in Admin / Orders / Email notifications.
EMAIL_REPLY_TO=
MANAGER_EMAIL=
# Configure private libpq service/password files for backup; do not put DB passwords in argv.
PGSERVICE=dari-backup
PGSERVICEFILE=/etc/dari/pg_service.conf
PGPASSFILE=/etc/dari/pgpass
